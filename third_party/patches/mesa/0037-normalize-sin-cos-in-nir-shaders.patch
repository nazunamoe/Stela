From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Brooks <bass_rock@me.com>
Date: Sun, 15 Nov 2026 02:34:22 +0000
Subject: [PATCH] radv: normalize sine and cosine and lower doubles in a shader
 given as NIR, as in one from SPIR-V

---
 src/amd/vulkan/radv_shader.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index e6e89e4778e454d59bbf8b6b19715be1314c0616..15237565bd9674c31e568570ce6323fd2b21d284 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -498,6 +498,10 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
          .point_coord = true,
       };
       NIR_PASS(_, nir, nir_lower_sysvals_to_varyings, &point_coord);
+      /* As the end of SPIR-V's path below: ACO takes sine and cosine only
+       * in the normalized form, and doubles only as the options lower them. */
+      NIR_PASS(_, nir, nir_lower_doubles, NULL, nir->options->lower_doubles_options);
+      NIR_PASS(_, nir, nir_normalize_sin_cos);
 
       assert(exec_list_length(&nir->functions) == 1);
       radv_shader_choose_subgroup_size(compiler_info, nir, &stage->key, 0);
